{
  "name": "ruta",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  // F-05: cuota diaria de /api/optimizar por usuario. Namespace KV "ruta-cuota-ors".
  // Sin este binding el worker solo aplica la verificación de pertenencia (sin cuota).
  "kv_namespaces": [
    { "binding": "CUOTA_ORS", "id": "4d223b1c8887484c8e23b4e77c182434" }
  ]
}
